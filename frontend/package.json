{
  "name": "frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --max-warnings=0 src",
    "generate:api": "openapi-generator-cli generate -i ../backend/api/openapi.yaml -g typescript-fetch -o generated/api",
    "clean:api": "rm -rf generated/api/* && mkdir -p generated/api",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:prod": "scripts/test-prod.sh",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "emoji-picker-element": "^1.29.1",
    "emoji-picker-element-data": "^1.8.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.32.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.3"
  }
}
